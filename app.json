{
  "expo": {
    "name": "Glimpse",
    "slug": "glimpse",
    "version": "1.3.0",
    "description": "プライベートな写真保管庫",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.totonowanaihibi.glimpse",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Glimpseの写真・動画を写真アプリに保存するために使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "写真や動画をGlimpseに取り込むため、また取り込み後に元の写真を削除したり、アルバムを写真アプリに書き出したりするために、フォトライブラリへのアクセスを使用します。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "写真や動画をGlimpseに取り込むため、また取り込み後に元の写真を削除したり、アルバムを写真アプリに書き出したりするために、フォトライブラリへのアクセスを使用します。",
          "savePhotosPermission": "Glimpseの写真・動画を写真アプリに保存するために使用します。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e1de4c1-a981-4194-ad0b-e050c3ad8855"
      }
    }
  }
}
